# ---------------------------------------------------------------------------
# DEV environment (default)
# Non-secret host configuration. Committed to git.
# Credentials belong in .env / .env.dev.local — never here.
# Any value below can be overridden by a real environment variable of the same
# name (CLI export or Azure pipeline variable).
# ---------------------------------------------------------------------------

APP_BASE_URL = https://advertiser.dev.fusetwo.com
MANAGEMENT_BASE_URL = https://management.dev.fusetwo.com
CONTROL_BASE_URL = https://control.corp.flexoffers.com

# The dev host currently serves a certificate whose common name does not match
# advertiser.dev.fusetwo.com (ERR_CERT_COMMON_NAME_INVALID), which blocks every
# navigation. Ignore TLS errors on this internal dev box, same as staging.
IGNORE_HTTPS_ERRORS = true

# Destructive / data-mutating tests (@write) are allowed here.
ALLOW_WRITE_TESTS = true
