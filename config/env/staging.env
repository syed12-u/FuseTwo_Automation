# ---------------------------------------------------------------------------
# STAGING environment
# Non-secret host configuration. Committed to git.
#
# Hosts verified 2026-08-20:
#   advertiserstg.fusetwo.com    -> HTTP 200 sign-in page, valid *.fusetwo.com cert
#   management.stg.fusetwo.com   -> 10.2.11.126, internal FLEX-DC01 cert, HTTP 401
#
# Note: "advertiser.stg.fusetwo.com" looks like the matching name but is NOT the
# advertiser app -- it resolves to the management box and returns 404. Use
# advertiserstg.fusetwo.com.
# ---------------------------------------------------------------------------

APP_BASE_URL = https://advertiserstg.fusetwo.com
MANAGEMENT_BASE_URL = https://management.stg.fusetwo.com
CONTROL_BASE_URL = https://control.corp.flexoffers.com

# The management staging host presents a certificate from the internal FLEX-DC01
# CA, which Chromium does not trust, so TLS verification is relaxed for this
# environment only. dev and prod both use publicly trusted certificates.
IGNORE_HTTPS_ERRORS = true

# Destructive / data-mutating tests (@write) are allowed on staging.
ALLOW_WRITE_TESTS = true
