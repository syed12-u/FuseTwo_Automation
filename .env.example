# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env holds CREDENTIALS ONLY — it is git-ignored and
# shared across every environment.
#
# Hosts are NOT configured here any more. They live in config/env/<env>.env and
# are selected with TEST_ENV=dev|staging|prod. Values for URL / HOME_URL /
# MANAGEMENT_URL left in .env are ignored and overwritten at startup, so a
# stale dev URL can no longer hijack a staging or prod run.
#
# For credentials that differ per environment, use .env.staging.local /
# .env.prod.local (also git-ignored) — those take precedence over .env.
# ---------------------------------------------------------------------------

# Advertiser portal login
FO_USERNAME = playwright@fusetwo.com
FO_PASSWORD = "TestConfirm1!"

# Management portal login (falls back to CONTROL_* when unset)
MANAGEMENT_USERNAME =
MANAGEMENT_PASSWORD =

# Legacy control site login
CONTROL_USERNAME = playwright@fusetwo.com
CONTROL_PASSWORD = "TestConfirm1!"

# BrightData proxy, used only by the geo-login suite
BRIGHTDATA_HOST =
BRIGHTDATA_PORT =
BRIGHTDATA_USERNAME =
BRIGHTDATA_PASSWORD =

# ---------------------------------------------------------------------------
# Mailbox access (Microsoft Graph) - reads the signup verification e-mail.
#
# Every automated registration is plus-addressed
# (syed.shah+auto...@flexoffers.com), so one real mailbox receives them all.
#
# These come from an Azure AD app registration with the Mail.Read APPLICATION
# permission and admin consent. A mailbox password is not supported: Microsoft
# has disabled basic authentication on modern tenants and MFA would block it.
#
# Leave blank and the mailbox-backed tests skip with a clear reason rather than
# passing as though the flow were covered.
# ---------------------------------------------------------------------------
GRAPH_TENANT_ID =
GRAPH_CLIENT_ID =
GRAPH_CLIENT_SECRET =
MAILBOX_ADDRESS = syed.shah@flexoffers.com
